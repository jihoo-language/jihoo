import Jihoo.NativeLoanValueProjection
import Jihoo.NativeFamilyIotaInjectivity

/-! Raw pure conversion generated by the existing Lend/family theory and the
two shaped Strict and Free equations. Its interpretation is the existing
composed Loan projection. Runtime ownership and source typing use separate
judgments. -/
namespace Jihoo.NativeKernel.Environment.RawValue

open NativeKernel.Conversion (ListRel)
open Semantics
open Semantics.ValueErasure (erase eraseArgs eraseArgs_map emit)
open Semantics.ValueErasure.Loan (project)

inductive Forward (env : Environment) : Term → Term → Prop where
  | old : RawLend.Forward env first second → Forward env first second
  | strict (first result : Term) : Forward env (.strict first result) result
  | free (owner result : Term) : Forward env (.free owner result) result
  | refl : Forward env term term
  | trans : Forward env first middle → Forward env middle result → Forward env first result
  | node (op : Op) : ListRel (Forward env) xs ys → Forward env (.node op xs) (.node op ys)

inductive Conv (env : Environment) : Term → Term → Prop where
  | old : RawLend.Conv env first second → Conv env first second
  | strict (first result : Term) : Conv env (.strict first result) result
  | free (owner result : Term) : Conv env (.free owner result) result
  | refl (term : Term) : Conv env term term
  | symm : Conv env first second → Conv env second first
  | trans : Conv env first middle → Conv env middle result → Conv env first result
  | node (op : Op) : ListRel (Conv env) xs ys → Conv env (.node op xs) (.node op ys)

theorem Forward.toConv (steps : Forward env first second) : Conv env first second := by
  induction steps using Forward.rec (motive_2 := fun xs ys _ => ListRel (Conv env) xs ys) with
  | old original => exact .old original.toConv
  | strict first result => exact .strict first result
  | free owner result => exact .free owner result
  | refl => exact .refl _
  | trans _ _ first second => exact .trans first second
  | node op _ ih => exact .node op ih
  | nil => exact .nil
  | cons _ _ first rest => exact .cons first rest

private theorem emit_forward (env : Environment) (op : Op) (args : List Term) :
    Forward env (.node op args) (emit op args) := by
  cases op <;> try exact .refl
  all_goals
    rcases args with _ | ⟨first, _ | ⟨result, _ | ⟨extra, rest⟩⟩⟩
    all_goals first | exact .refl | exact .strict first result | exact .free first result

theorem erase_forward (env : Environment) (term : Term) : Forward env term (erase term) := by
  induction term using Term.rec (motive_2 := fun args => ListRel (Forward env) args (eraseArgs args)) with
  | var => simpa only [erase] using (Forward.refl (env := env))
  | node op args ih => simpa only [erase] using (Forward.node op ih).trans (emit_forward env op (eraseArgs args))
  | nil => simp only [eraseArgs]; exact .nil
  | cons _ _ first rest => simpa only [eraseArgs] using ListRel.cons first rest

/-- Concrete finite steps reach the existing composed projection in the
original global and family environment. -/
theorem project_forward (env : Environment) (term : Term) : Forward env term (project env term) :=
  (Forward.old (RawLend.project_forward env term)).trans
    ((Forward.old (.old (.old (EnvironmentDelta.expand_forward env _)))).trans (erase_forward env _))

private theorem value_project_cons (env : Environment) (op : Op) (first : Term) (rest : List Term) :
    ValueErasure.project env (.node op (first :: rest)) =
      emit op ((first :: rest).map (ValueErasure.project env)) := by
  rw [ValueErasure.project, EnvironmentDelta.expand_node_cons, erase, eraseArgs_map,
    EnvironmentDelta.expandArgs_map, List.map_cons, List.map_map]
  rfl

private theorem project_other_cons {op : Op} (other : op ≠ .lend) (env : Environment)
    (first : Term) (rest : List Term) :
    project env (.node op (first :: rest)) = emit op ((first :: rest).map (project env)) := by
  have args : RawLend.unlendArgs (EnvironmentDelta.expandArgs env (first :: rest)) =
      RawLend.project env first :: rest.map (RawLend.project env) := by
    simp only [RawLend.unlendArgs_map, EnvironmentDelta.expandArgs_map, List.map_map, List.map_cons]
    rfl
  rw [project, RawLend.project_node_nonempty, RawLend.rebuild_other other, args,
    value_project_cons, List.map_cons, List.map_map]
  rfl

private theorem project_lend_node (env : Environment) (args : List Term) :
    project env (.node .lend args) = RawLend.rebuild .lend (args.map (project env)) := by
  rcases args with _ | ⟨owner, _ | ⟨reader, _ | ⟨continuation, _ | ⟨extra, rest⟩⟩⟩⟩
  all_goals first
    | exact Semantics.ValueErasure.Loan.project_lend env _ _ _
    | simp [project, RawLend.project_ordinary (op := .lend) rfl, RawLend.rebuild,
        ValueErasure.project_ordinary_node (op := .lend) rfl, emit, List.map_map, Function.comp_def]

private theorem emit_congruence (op : Op)
    (related : ListRel (FamilyIota.Extended.Conv env) first second) :
    FamilyIota.Extended.Conv env (emit op first) (emit op second) := by
  cases op <;> try exact .node _ related
  all_goals
    cases related with
    | nil => exact .refl _
    | cons first tail =>
        cases tail with
        | nil => exact .node _ (.cons first .nil)
        | cons result rest =>
            cases rest with
            | nil => exact result
            | cons extra rest => exact .node _ (.cons first (.cons result (.cons extra rest)))

/-- Includes malformed arities and open terms. Nonempty Global nodes keep
their head, while identical empty Global nodes can expand by actual lookup. -/
private theorem project_node_congr (op : Op) (children : ListRel (Conv env) xs ys)
    (related : ListRel (FamilyIota.Extended.Conv env) (xs.map (project env)) (ys.map (project env))) :
    FamilyIota.Extended.Conv env (project env (.node op xs)) (project env (.node op ys)) := by
  by_cases lend : op = .lend
  · subst op
    rw [project_lend_node, project_lend_node]
    exact RawLend.rebuild_family_congruence _ related
  · cases children with
    | nil => exact .refl _
    | cons first rest =>
        rw [project_other_cons lend, project_other_cons lend]
        exact emit_congruence op related

theorem Conv.projected (converted : Conv env first second) (admissible : EnvironmentDelta.Admissible env) :
    FamilyIota.Extended.Conv env (project env first) (project env second) := by
  induction converted using Conv.rec
    (motive_2 := fun xs ys _ => ListRel (FamilyIota.Extended.Conv env) (xs.map (project env)) (ys.map (project env))) with
  | old original => exact Semantics.ValueErasure.Loan.conversion admissible original
  | strict first result =>
      rw [Semantics.ValueErasure.Loan.project_strict]
      exact .refl _
  | free owner result =>
      rw [Semantics.ValueErasure.Loan.project_free]
      exact .refl _
  | refl => exact .refl _
  | symm _ ih => exact .symm ih
  | trans _ _ first second => exact .trans first second
  | node op children ih => exact project_node_congr op children ih
  | nil => exact .nil
  | cons _ _ first rest => exact .cons first rest

theorem Conv.ofProjected (converted : FamilyIota.Extended.Conv env (project env first) (project env second)) :
    Conv env first second :=
  (project_forward env first).toConv.trans ((Conv.old (.old converted)).trans (project_forward env second).toConv.symm)

/-- Exact equivalence between the enlarged raw congruence and the existing
projected family conversion. -/
theorem conv_iff_projection (admissible : EnvironmentDelta.Admissible env) :
    Conv env first second ↔ FamilyIota.Extended.Conv env (project env first) (project env second) :=
  ⟨fun converted => converted.projected admissible, Conv.ofProjected⟩

theorem Conv.church_rosser (converted : Conv env first second) (admissible : EnvironmentDelta.Admissible env) :
    ∃ common, Forward env first common ∧ Forward env second common := by
  obtain ⟨common, left, right⟩ := (converted.projected admissible).church_rosser admissible
  exact ⟨common, (project_forward env first).trans (.old (.old left)),
    (project_forward env second).trans (.old (.old right))⟩

theorem Forward.confluence (left : Forward env source first) (right : Forward env source second)
    (admissible : EnvironmentDelta.Admissible env) :
    ∃ common, Forward env first common ∧ Forward env second common :=
  (left.toConv.symm.trans right.toConv).church_rosser admissible

theorem Conv.renaming (converted : Conv env first second) (indices : Nat → Nat)
    (admissible : EnvironmentDelta.Admissible env) :
    Conv env (first.rename indices) (second.rename indices) := by
  apply Conv.ofProjected
  rw [Semantics.ValueErasure.Loan.project_renaming admissible,
    Semantics.ValueErasure.Loan.project_renaming admissible]
  exact (converted.projected admissible).renaming indices admissible.closed

theorem Conv.substitution (converted : Conv env first second) (values : Nat → Term)
    (admissible : EnvironmentDelta.Admissible env) :
    Conv env (first.subst values) (second.subst values) := by
  apply Conv.ofProjected
  rw [Semantics.ValueErasure.Loan.project_substitution admissible,
    Semantics.ValueErasure.Loan.project_substitution admissible]
  exact (converted.projected admissible).substitution (fun index => project env (values index)) admissible.closed

theorem Conv.subst_congr (admissible : EnvironmentDelta.Admissible env)
    (values : ∀ index, Conv env (first index) (second index)) (term : Term) :
    Conv env (term.subst first) (term.subst second) :=
  Conv.ofProjected (Semantics.ValueErasure.Loan.Coherent.subst_congr admissible
    (fun index => (values index).projected admissible) term)

private theorem project_eq (env : Environment) (first second : Term) :
    project env (.eq first second) = .eq (project env first) (project env second) := by
  rw [Term.eq, Semantics.ValueErasure.Loan.project_ordinary_node (by rfl) (by decide)]
  rfl

theorem Conv.eq_injective (converted : Conv env (.eq a b) (.eq a' b'))
    (admissible : EnvironmentDelta.Admissible env) : Conv env a a' ∧ Conv env b b' := by
  have projected := converted.projected admissible
  rw [project_eq, project_eq] at projected
  obtain ⟨left, right⟩ := projected.eq_injective admissible
  exact ⟨Conv.ofProjected left, Conv.ofProjected right⟩

theorem Conv.pi_injective (converted : Conv env (.pi erased domain body) (.pi erased' domain' body'))
    (admissible : EnvironmentDelta.Admissible env) :
    erased = erased' ∧ Conv env domain domain' ∧ Conv env body body' := by
  have projected := converted.projected admissible
  rw [Semantics.ValueErasure.Loan.project_pi, Semantics.ValueErasure.Loan.project_pi] at projected
  obtain ⟨erasure, domains, bodies⟩ := projected.pi_injective admissible
  exact ⟨erasure, Conv.ofProjected domains, Conv.ofProjected bodies⟩

theorem free_eq_forward (owner first second : Term) :
    Forward env (.eq (.free owner first) second) (.eq first second) :=
  .node .eq (.cons (.free owner first) (.cons .refl .nil))

/-- Variable zero occurs underneath the Pi binder in both sides of its
equality. The context contracts both wrappers and retains that binder. -/
theorem strict_free_pi_forward (erased : Bool) (domain before owner : Term) :
    Forward env (.pi erased domain (.eq (.strict before (.free owner (.var 0))) (.var 0)))
      (.pi erased domain (.eq (.var 0) (.var 0))) :=
  .node (.pi erased) (.cons .refl (.cons
    ((Forward.node .eq (.cons (.strict before (.free owner (.var 0))) (.cons .refl .nil))).trans
      (free_eq_forward owner (.var 0) (.var 0))) .nil))

end Jihoo.NativeKernel.Environment.RawValue
