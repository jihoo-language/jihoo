// Check the arena rows and exact work used by the ghost inference fixtures
// in NativeCoreGhostSpineInference. The public atomic normalizer
// charges one tick per call, so the shared checker limit measures inference
// cost without exposing or modifying Core's private counter.
import core
import diag

fn fixture() -> core.Core {
    var c = core.Core.new()
    let span = diag.Span.nowhere()
    let seven = c.add(core.Term.Natural(7), span).unwrap()
    let one = c.add(core.Term.Natural(1), span).unwrap()
    let sum = c.add(core.Term.UAdd(seven, one), span).unwrap()
    c.add(core.Term.Eq(sum, sum), span).unwrap()
    c.add(core.Term.Refl(sum), span).unwrap()
    let signed = c.add(core.Term.Integer(1), span).unwrap()
    c.add(core.Term.Eq(signed, sum), span).unwrap()
    c
}

fn spend(inout c: core.Core, count: i64) {
    for _ in 0..count {
        assert(c.normal(0, core.DEPTH).unwrap() == 0, "atomic normalization")
    }
}

fn assert_spent(inout c: core.Core, message: str) {
    assert(match c.normal(0, core.DEPTH) {
        Err(e) => e.msg == "core: checking step limit reached", _ => false
    }, message)
}

fn primitive_inference() {
    var good = fixture()
    spend(&good, 999987)
    let inferred = good.infer(4, [], true, 16).unwrap()
    assert(inferred == 12 && good.node_count() == 13, "result position")
    for i in 7..12 { assert(good.term(i as u32) == core.Term.U64, "expected word rows") }
    assert(good.term(inferred) == core.Term.Eq(2, 2), "original sum references")
    assert_spent(&good, "successful inference used 13 ticks")

    var bad = fixture()
    spend(&bad, 999995)
    assert(match bad.infer(6, [], true, 16) {
        Err(e) => e.msg == "core: type mismatch", _ => false
    }, "signed operand rejected")
    assert(bad.node_count() == 9 && bad.term(7) == core.Term.U64 && bad.term(8) == core.Term.I64,
        "only first operand's rows remain")
    assert_spent(&bad, "rejected inference used 5 ticks")
}

fn erased_lambda() {
    var c = core.Core.new()
    let span = diag.Span.nowhere()
    let word = c.add(core.Term.U64, span).unwrap()
    let index = c.add(core.Term.Var(0), span).unwrap()
    let proof = c.add(core.Term.Refl(index), span).unwrap()
    let lambda = c.add(core.Term.Lam(true, word, proof), span).unwrap()
    let equality = c.add(core.Term.Eq(index, index), span).unwrap()
    c.add(core.Term.Pi(true, word, equality), span).unwrap()
    spend(&c, 999990)
    let inferred = c.infer(lambda, [], true, 16).unwrap()
    assert(inferred == 9 && c.node_count() == 10, "lambda result position")
    assert(c.term(6) == core.Term.Universe(0) && c.term(7) == core.Term.U64, "lambda formation rows")
    assert(c.term(8) == core.Term.Eq(index, index), "lambda codomain refers to the bound word")
    assert(c.term(inferred) == core.Term.Pi(true, word, 8), "lambda keeps the written domain")
    assert_spent(&c, "lambda inference used 10 ticks")
}

fn impredicative_product() {
    var c = core.Core.new()
    let span = diag.Span.nowhere()
    let highest = c.add(core.Term.Universe(31), span).unwrap()
    let zero = c.add(core.Term.Natural(0), span).unwrap()
    let equality = c.add(core.Term.Eq(zero, zero), span).unwrap()
    let product = c.add(core.Term.Pi(false, highest, equality), span).unwrap()
    c.add(core.Term.Prop, span).unwrap()
    spend(&c, 999987)
    let inferred = c.infer(product, [], true, 16).unwrap()
    assert(inferred == 10 && c.node_count() == 11, "product result position")
    assert(c.term(5) == core.Term.Universe(32), "administrative universe of the domain")
    for i in 6..9 { assert(c.term(i as u32) == core.Term.U64, "equality formation rows") }
    assert(c.term(9) == core.Term.Prop && c.term(inferred) == core.Term.Prop, "impredicative product")
    assert_spent(&c, "product inference used 13 ticks")
}

fn decision_fixture() -> core.Core {
    var c = core.Core.new()
    let span = diag.Span.nowhere()
    let one = c.add(core.Term.Natural(1), span).unwrap()
    let two = c.add(core.Term.Natural(2), span).unwrap()
    c.add(core.Term.Lt(one, two), span).unwrap()
    let valid = c.add(core.Term.Decide(one, two), span).unwrap()
    c.add(core.Term.Decide(two, one), span).unwrap()
    let prefix = c.add(core.Term.Integer(0), span).unwrap()
    c.add(core.Term.Strict(prefix, valid), span).unwrap()
    c
}

fn decision_inference() {
    var good = decision_fixture()
    spend(&good, 999987)
    let inferred = good.infer(6, [], true, 16).unwrap()
    assert(inferred == 11 && good.node_count() == 12, "strict decision result position")
    assert(good.term(7) == core.Term.I64, "the Strict prefix is inferred first")
    for i in 8..11 { assert(good.term(i as u32) == core.Term.U64, "decision operand types") }
    assert(good.term(inferred) == core.Term.Lt(0, 1), "decision returns the original operands")
    assert_spent(&good, "strict decision inference used 13 ticks")

    var bad = decision_fixture()
    spend(&bad, 999989)
    assert(match bad.infer(4, [], true, 16) {
        Err(e) => e.msg == "core: decide-lt needs a true closed inequality", _ => false
    }, "descending inequality rejected")
    assert(bad.node_count() == 10, "the failed decision preserves its operand types")
    for i in 7..10 { assert(bad.term(i as u32) == core.Term.U64, "rejected decision operand types") }
    assert_spent(&bad, "rejected decision used 11 ticks")
}

fn zero_bound_inference() {
    var c = core.Core.new()
    let span = diag.Span.nowhere()
    let maximum = c.add(core.Term.Natural(18446744073709551615), span).unwrap()
    let proof = c.add(core.Term.ZeroLe(maximum), span).unwrap()
    let zero = c.add(core.Term.Natural(0), span).unwrap()
    let one = c.add(core.Term.Natural(1), span).unwrap()
    let successor = c.add(core.Term.UAdd(maximum, one), span).unwrap()
    c.add(core.Term.Lt(zero, successor), span).unwrap()
    spend(&c, 999995)
    let inferred = c.infer(proof, [], true, 16).unwrap()
    assert(inferred == 11 && c.node_count() == 12, "zero bound result position")
    assert(c.term(6) == core.Term.U64 && c.term(7) == core.Term.U64, "zero bound operand check")
    assert(c.term(8) == core.Term.Natural(0) && c.term(9) == core.Term.Natural(1), "zero bound constants")
    assert(c.term(10) == core.Term.UAdd(maximum, 9), "successor remains a ghost sum")
    assert(c.term(inferred) == core.Term.Lt(8, 10), "zero bound keeps the wide successor")
    assert_spent(&c, "zero bound inference used five ticks")
}

fn subtract_bound_exhaustion() {
    var c = core.Core.new()
    let span = diag.Span.nowhere()
    let zero = c.add(core.Term.Natural(0), span).unwrap()
    let proof = c.add(core.Term.ZeroLe(zero), span).unwrap()
    let subtract = c.add(core.Term.USub(zero, zero, proof), span).unwrap()
    c.add(core.Term.U64, span).unwrap()
    spend(&c, 999986)
    assert(match c.infer(subtract, [], true, 16) {
        Err(e) => e.msg == "core: checking step limit reached", _ => false
    }, "subtraction stops at the bound comparison tick")
    assert(c.node_count() == 16, "both subtraction bound graphs remain")
    for i in 4..7 { assert(c.term(i as u32) == core.Term.U64, "subtraction operand check") }
    assert(c.term(7) == core.Term.Natural(1) && c.term(8) == core.Term.UAdd(zero, 7), "required successor")
    assert(c.term(9) == core.Term.Lt(zero, 8), "required subtraction bound")
    assert(c.term(10) == core.Term.U64 && c.term(11) == core.Term.U64, "bound proof operand check")
    assert(c.term(12) == core.Term.Natural(0) && c.term(13) == core.Term.Natural(1), "inferred bound constants")
    assert(c.term(14) == core.Term.UAdd(zero, 13) && c.term(15) == core.Term.Lt(12, 14), "inferred subtraction bound")
}

fn conditional_inference() {
    var c = core.Core.new()
    let span = diag.Span.nowhere()
    let one = c.add(core.Term.Natural(1), span).unwrap()
    let two = c.add(core.Term.Natural(2), span).unwrap()
    let assumed = c.add(core.Term.Var(0), span).unwrap()
    let alternate = c.add(core.Term.Decide(one, two), span).unwrap()
    c.add(core.Term.Lt(one, two), span).unwrap()
    let condition = c.add(core.Term.IfLt(one, two, assumed, alternate), span).unwrap()
    spend(&c, 999961)
    let inferred = c.infer(condition, [], true, 16).unwrap()
    assert(inferred == 9 && c.node_count() == 14, "conditional returns the lowered assumption type")
    for i in 6..9 { assert(c.term(i as u32) == core.Term.U64, "condition operand types") }
    for i in 10..13 { assert(c.term(i as u32) == core.Term.U64, "alternative operand types") }
    assert(c.term(inferred) == core.Term.Lt(one, two) && c.term(13) == core.Term.Lt(one, two), "branch types")
    assert_spent(&c, "conditional inference used 39 ticks")
}

fn refinement_predicate(inout c: core.Core) -> u32 {
    let span = diag.Span.nowhere()
    let word = c.add(core.Term.U64, span).unwrap()
    let argument = c.add(core.Term.Var(0), span).unwrap()
    let equality = c.add(core.Term.Eq(argument, argument), span).unwrap()
    c.add(core.Term.Lam(false, word, equality), span).unwrap()
}

fn refinement_inference() {
    var c = core.Core.new()
    let span = diag.Span.nowhere()
    let predicate = refinement_predicate(&c)
    let refinement = c.add(core.Term.Refine(predicate), span).unwrap()
    c.add(core.Term.Universe(0), span).unwrap()
    spend(&c, 999976)
    let inferred = c.infer(refinement, [], true, 24).unwrap()
    assert(inferred == 13 && c.node_count() == 14, "refinement result position")
    assert(c.term(6) == core.Term.U64 && c.term(7) == core.Term.Prop, "required predicate domain and range")
    assert(c.term(8) == core.Term.Pi(false, 6, 7), "required predicate arrow")
    assert(c.term(9) == core.Term.Universe(0) && c.term(10) == core.Term.U64, "predicate checks")
    assert(c.term(11) == core.Term.Prop && c.term(12) == core.Term.Pi(false, 0, 11), "inferred predicate arrow")
    assert(c.term(inferred) == core.Term.Universe(0), "refinements inhabit Type0")
    assert_spent(&c, "refinement inference used 24 ticks")
}

fn pack_evidence_exhaustion() {
    var c = core.Core.new()
    let span = diag.Span.nowhere()
    let predicate = refinement_predicate(&c)
    c.add(core.Term.Refine(predicate), span).unwrap()
    let word = c.add(core.Term.Natural(7), span).unwrap()
    let evidence = c.add(core.Term.Refl(word), span).unwrap()
    let pack = c.add(core.Term.Pack(predicate, word, evidence), span).unwrap()
    spend(&c, 999972)
    assert(match c.infer(pack, [], true, 24) {
        Err(e) => e.msg == "core: checking step limit reached", _ => false
    }, "packing exhausts the budget entering evidence inference")
    assert(c.node_count() == 18, "required predicate application survives exhaustion")
    assert(c.term(8) == core.Term.U64 && c.term(9) == core.Term.Prop, "packing predicate domain and range")
    assert(c.term(10) == core.Term.Pi(false, 8, 9), "packing predicate arrow")
    assert(c.term(11) == core.Term.Universe(0) && c.term(12) == core.Term.U64, "packing predicate checks")
    assert(c.term(13) == core.Term.Prop && c.term(14) == core.Term.Pi(false, 0, 13), "inferred packing predicate")
    assert(c.term(15) == core.Term.U64 && c.term(16) == core.Term.U64, "witness type check")
    assert(c.term(17) == core.Term.App(predicate, word), "evidence type uses the original witness")
}

fn proof_irrelevance_under_type_family() {
    var c = core.Core.new()
    let span = diag.Span.nowhere()
    let u = c.add(core.Term.U64, span).unwrap()
    let arg = c.add(core.Term.Var(0), span).unwrap()
    let zero = c.add(core.Term.Natural(0), span).unwrap()
    let one = c.add(core.Term.Natural(1), span).unwrap()
    let bound = c.add(core.Term.Lt(arg, one), span).unwrap()
    let predicate = c.add(core.Term.Lam(false, u, bound), span).unwrap()
    let refined = c.add(core.Term.Refine(predicate), span).unwrap()
    let sort = c.add(core.Term.Universe(0), span).unwrap()
    let family = c.add(core.Term.Pi(false, refined, sort), span).unwrap()
    let by_zero = c.add(core.Term.ZeroLe(zero), span).unwrap()
    let by_decision = c.add(core.Term.Decide(zero, one), span).unwrap()
    let first = c.add(core.Term.Pack(predicate, zero, by_zero), span).unwrap()
    let second = c.add(core.Term.Pack(predicate, zero, by_decision), span).unwrap()
    let left_body = c.add(core.Term.App(arg, first), span).unwrap()
    let right_body = c.add(core.Term.App(arg, second), span).unwrap()
    let left = c.add(core.Term.Pi(false, family, left_body), span).unwrap()
    let right = c.add(core.Term.Pi(false, family, right_body), span).unwrap()
    let left_sort = c.infer(left, [], true, core.DEPTH).unwrap()
    let right_sort = c.infer(right, [], true, core.DEPTH).unwrap()
    assert(c.term(left_sort) == core.Term.Universe(1), "left type is closed and well-formed")
    assert(c.term(right_sort) == core.Term.Universe(1), "right type is closed and well-formed")
    assert(c.equal(left, right, core.DEPTH).unwrap(), "dependent type comparison skips both Pack proofs")
}

fn refinement_projection() {
    var c = core.Core.new()
    let span = diag.Span.nowhere()
    let predicate = refinement_predicate(&c)
    let refinement = c.add(core.Term.Refine(predicate), span).unwrap()
    let subject = c.add(core.Term.Var(0), span).unwrap()
    let proof = c.add(core.Term.Proof(subject), span).unwrap()
    let context = [core.Binding { ty: refinement, erased: false }]
    spend(&c, 999986)
    let inferred = c.infer(proof, context, true, 24).unwrap()
    assert(inferred == 8 && c.node_count() == 9, "proof projection result position")
    assert(c.term(7) == core.Term.Witness(subject), "proof projection keeps the original subject")
    assert(c.term(inferred) == core.Term.App(predicate, 7), "proof projection applies its predicate")
    assert_spent(&c, "proof projection used 14 ticks")
}

fn transport_evidence_exhaustion() {
    var c = core.Core.new()
    let span = diag.Span.nowhere()
    let predicate = refinement_predicate(&c)
    let seven = c.add(core.Term.Natural(7), span).unwrap()
    let proof = c.add(core.Term.Refl(seven), span).unwrap()
    let transport = c.add(core.Term.Transport(predicate, proof, proof), span).unwrap()
    c.add(core.Term.Eq(seven, seven), span).unwrap()
    spend(&c, 999968)
    assert(match c.infer(transport, [], true, 24) {
        Err(e) => e.msg == "core: checking step limit reached", _ => false
    }, "transport runs out of budget entering the source proof")
    assert(c.node_count() == 19, "exposed equality and required fiber survive exhaustion")
    assert(c.term(17) == core.Term.Eq(seven, seven), "transport exposes the inferred equality")
    assert(c.term(18) == core.Term.App(predicate, seven), "transport requires the original source fiber")
}

fn offset_proof_fixture() -> core.Core {
    var c = core.Core.new()
    let span = diag.Span.nowhere()
    let zero = c.add(core.Term.Natural(0), span).unwrap()
    let one = c.add(core.Term.Natural(1), span).unwrap()
    let two = c.add(core.Term.Natural(2), span).unwrap()
    let bound = c.add(core.Term.Decide(zero, one), span).unwrap()
    c.add(core.Term.LtAdd(zero, one, two, bound), span).unwrap()
    let left = c.add(core.Term.UAdd(zero, two), span).unwrap()
    let right = c.add(core.Term.UAdd(one, two), span).unwrap()
    c.add(core.Term.Lt(left, right), span).unwrap()
    c
}

fn offset_proof_inference() {
    var limited = offset_proof_fixture()
    spend(&limited, 999987)
    assert(match limited.infer(4, [], true, 16) {
        Err(e) => e.msg == "core: checking step limit reached", _ => false
    }, "offset proof exhausts the budget entering the original evidence")
    assert(limited.node_count() == 16, "both offset bounds survive exhaustion")
    assert(limited.term(12) == core.Term.UAdd(0, 2) && limited.term(13) == core.Term.UAdd(1, 2),
        "both sums keep the original offset")
    assert(limited.term(14) == core.Term.Lt(0, 1) && limited.term(15) == core.Term.Lt(12, 13),
        "both propositions are present")

    var added = offset_proof_fixture()
    let inferred = added.infer(4, [], true, 16).unwrap()
    assert(inferred == 15 && added.term(inferred) == core.Term.Lt(12, 13), "LtAdd returns the shifted inequality")

    var cancelled = offset_proof_fixture()
    let cancel = cancelled.add(core.Term.LtCancel(0, 1, 2, 4), diag.Span.nowhere()).unwrap()
    let original = cancelled.infer(cancel, [], true, 16).unwrap()
    assert(cancelled.term(original) == core.Term.Lt(0, 1), "LtCancel returns the original inequality")
}

fn transitive_proof_fixture() -> core.Core {
    var c = core.Core.new()
    let span = diag.Span.nowhere()
    let zero = c.add(core.Term.Natural(0), span).unwrap()
    let one = c.add(core.Term.Natural(1), span).unwrap()
    let two = c.add(core.Term.Natural(2), span).unwrap()
    let three = c.add(core.Term.Natural(3), span).unwrap()
    let lower = c.add(core.Term.Decide(zero, one), span).unwrap()
    let upper = c.add(core.Term.Decide(one, three), span).unwrap()
    c.add(core.Term.LtLe(zero, one, two, lower, upper), span).unwrap()
    c.add(core.Term.Lt(zero, two), span).unwrap()
    c
}

fn transitive_proof_inference() {
    var limited = transitive_proof_fixture()
    spend(&limited, 999987)
    assert(match limited.infer(6, [], true, 24) {
        Err(e) => e.msg == "core: checking step limit reached", _ => false
    }, "transitivity exhausts the budget before checking the first proof")
    assert(limited.node_count() == 16, "both transitivity bounds survive exhaustion")
    assert(limited.term(12) == core.Term.Natural(1) && limited.term(13) == core.Term.UAdd(2, 12),
        "the upper bound keeps the original endpoint and fresh successor")
    assert(limited.term(14) == core.Term.Lt(0, 1) && limited.term(15) == core.Term.Lt(1, 13),
        "the lower and upper propositions were built in order")

    var closed = transitive_proof_fixture()
    spend(&closed, 999943)
    let inferred = closed.infer(6, [], true, 24).unwrap()
    assert(inferred == 26 && closed.node_count() == 27 && closed.term(inferred) == core.Term.Lt(0, 2),
        "transitivity commits the original endpoints after both proofs")
    assert_spent(&closed, "successful transitivity inference uses exactly 57 ticks")
}

fn absurd_inference() {
    var c = core.Core.new()
    let span = diag.Span.nowhere()
    let zero = c.add(core.Term.Natural(0), span).unwrap()
    let bound = c.add(core.Term.Lt(zero, zero), span).unwrap()
    let target = c.add(core.Term.U64, span).unwrap()
    let evidence = c.add(core.Term.Var(0), span).unwrap()
    let impossible = c.add(core.Term.Absurd(target, evidence), span).unwrap()
    let context = [core.Binding { ty: bound, erased: true }]
    spend(&c, 999989)
    assert(c.infer(impossible, context, true, 24).unwrap() == target,
        "absurd returns the original target type")
    assert_spent(&c, "absurd normalizes the upper endpoint after exposing Lt")
}

fn wide_ghost_sum() {
    var c = core.Core.new()
    let span = diag.Span.nowhere()
    let largest = c.add(core.Term.Natural(18446744073709551615), span).unwrap()
    let one = c.add(core.Term.Natural(1), span).unwrap()
    let sum = c.add(core.Term.UAdd(largest, one), span).unwrap()
    spend(&c, 999995)
    let value = c.normal(sum, 8).unwrap()
    assert(value == 4 && c.node_count() == 5, "wide ghost sum commits one shared half and the result")
    assert(c.term(3) == core.Term.Natural(9223372036854775808), "wide sum halves fit U64")
    assert(c.term(value) == core.Term.UAdd(3, 3), "equal halves reuse one graph reference")
    assert_spent(&c, "wide ghost sum uses five ticks")
}

fn array_fixture() -> core.Core {
    var c = core.Core.new()
    let span = diag.Span.nowhere()
    var elements = Vec(u32).new()
    elements.push(c.add(core.Term.Integer(3), span).unwrap())
    elements.push(c.add(core.Term.Integer(-4), span).unwrap())
    c.add(core.Term.Elements(elements), span).unwrap()
    let length = c.add(core.Term.Natural(2), span).unwrap()
    c.add(core.Term.Array(length), span).unwrap()
    c
}

fn array_and_allocation_inference() {
    var limited = array_fixture()
    spend(&limited, 999995)
    assert(match limited.infer(2, [], true, 20) {
        Err(e) => e.msg == "core: checking step limit reached", _ => false
    }, "array checks its second element before committing the length")
    assert(limited.node_count() == 7, "array keeps each prior signed comparison node")

    var array = array_fixture()
    spend(&array, 999991)
    let inferred = array.infer(2, [], true, 20).unwrap()
    assert(inferred == 9 && array.term(8) == core.Term.Natural(2) && array.term(inferred) == core.Term.Array(8),
        "array type uses the emitted element count")
    assert_spent(&array, "array inference uses nine ticks")

    var allocation = core.Core.new()
    let span = diag.Span.nowhere()
    let count = allocation.add(core.Term.Natural(2), span).unwrap()
    let fill = allocation.add(core.Term.Integer(-7), span).unwrap()
    let source = allocation.add(core.Term.Alloc(count, fill), span).unwrap()
    allocation.add(core.Term.Buffer(count), span).unwrap()
    spend(&allocation, 999991)
    let buffer = allocation.infer(source, [], true, 20).unwrap()
    assert(buffer == 8 && allocation.term(buffer) == core.Term.Buffer(count), "buffer type keeps the source count")
    assert_spent(&allocation, "allocation inference uses nine ticks")
}

fn buffer_operations_fixture() -> core.Core {
    var c = core.Core.new()
    let span = diag.Span.nowhere()
    let count = c.add(core.Term.Natural(2), span).unwrap()
    let index = c.add(core.Term.Natural(0), span).unwrap()
    let fill = c.add(core.Term.Integer(-7), span).unwrap()
    let owner = c.add(core.Term.Alloc(count, fill), span).unwrap()
    let bound = c.add(core.Term.Decide(index, count), span).unwrap()
    let stored = c.add(core.Term.Store(owner, index, fill, bound), span).unwrap()
    let tail = c.add(core.Term.Natural(9), span).unwrap()
    c.add(core.Term.Free(stored, tail), span).unwrap()
    c.add(core.Term.Buffer(count), span).unwrap()
    c.add(core.Term.U64, span).unwrap()
    c
}

fn buffer_operation_inference() {
    var limited = buffer_operations_fixture()
    spend(&limited, 999980)
    assert(match limited.infer(5, [], true, 32) {
        Err(e) => e.msg == "core: checking step limit reached", _ => false
    }, "store exhausts the budget upon entering its bound evidence")
    assert(limited.node_count() == 20 && limited.term(19) == core.Term.Lt(1, 0), "store retains its original bound")

    var stored = buffer_operations_fixture()
    spend(&stored, 999960)
    let owner = stored.infer(5, [], true, 32).unwrap()
    assert(owner == 24 && stored.term(owner) == core.Term.Buffer(0), "store keeps its original buffer length")
    assert_spent(&stored, "store inference uses 40 ticks")

    var released = buffer_operations_fixture()
    spend(&released, 999956)
    let result = released.infer(7, [], true, 32).unwrap()
    assert(result == 25 && released.term(result) == core.Term.U64, "free returns the checked continuation type")
    assert_spent(&released, "free inference with the store uses 44 ticks")
}

fn indexing_fixture() -> core.Core {
    var c = core.Core.new()
    let span = diag.Span.nowhere()
    let length = c.add(core.Term.Natural(2), span).unwrap()
    let index = c.add(core.Term.Natural(1), span).unwrap()
    var elements = Vec(u32).new()
    elements.push(c.add(core.Term.Integer(3), span).unwrap())
    elements.push(c.add(core.Term.Integer(-4), span).unwrap())
    let array = c.add(core.Term.Elements(elements), span).unwrap()
    let bound = c.add(core.Term.Decide(index, length), span).unwrap()
    c.add(core.Term.Index(array, index, bound), span).unwrap()
    let buffer = c.add(core.Term.Buffer(length), span).unwrap()
    let reference = c.add(core.Term.Ref(buffer), span).unwrap()
    let borrowed = c.add(core.Term.Var(0), span).unwrap()
    let read = c.add(core.Term.Index(borrowed, index, bound), span).unwrap()
    let signed = c.add(core.Term.I64, span).unwrap()
    c.add(core.Term.Lam(false, reference, read), span).unwrap()
    c.add(core.Term.Pi(false, reference, signed), span).unwrap()
    c
}

fn array_and_borrowed_index_inference() {
    var array = indexing_fixture()
    spend(&array, 999964)
    let array_result = array.infer(6, [], true, 32).unwrap()
    assert(array_result == 26 && array.term(21) == core.Term.Lt(1, 17) && array.term(array_result) == core.Term.I64,
        "array indexing uses the inferred array length before returning a signed word")
    assert_spent(&array, "array indexing uses 36 ticks")

    var borrowed = indexing_fixture()
    let context = [core.Binding { ty: 8, erased: false }]
    spend(&borrowed, 999966)
    let borrowed_result = borrowed.infer(10, context, true, 32).unwrap()
    assert(borrowed_result == 21 && borrowed.term(16) == core.Term.Lt(1, 0) && borrowed.term(borrowed_result) == core.Term.I64,
        "borrowed indexing uses the original buffer length before returning a signed word")
    assert_spent(&borrowed, "borrowed indexing uses 34 ticks")
}

fn load_fixture() -> core.Core {
    var c = core.Core.new()
    let span = diag.Span.nowhere()
    let zero = c.add(core.Term.Natural(0), span).unwrap()
    let word = c.add(core.Term.U64, span).unwrap()
    let signed = c.add(core.Term.I64, span).unwrap()
    let length = c.add(core.Term.Var(0), span).unwrap()
    let bound = c.add(core.Term.Lt(zero, length), span).unwrap()
    let outside_length = c.add(core.Term.Var(1), span).unwrap()
    let fill = c.add(core.Term.Integer(-7), span).unwrap()
    let owner = c.add(core.Term.Alloc(outside_length, fill), span).unwrap()
    let lifted_length = c.add(core.Term.Var(2), span).unwrap()
    let buffer = c.add(core.Term.Buffer(lifted_length), span).unwrap()
    let body = c.add(core.Term.Free(length, outside_length), span).unwrap()
    let after_owner = c.add(core.Term.Lam(false, buffer, body), span).unwrap()
    let callback = c.add(core.Term.Lam(false, signed, after_owner), span).unwrap()
    let load = c.add(core.Term.Load(owner, zero, length, callback), span).unwrap()
    let assume = c.add(core.Term.Lam(true, bound, load), span).unwrap()
    c.add(core.Term.Lam(false, word, assume), span).unwrap()
    let proof_function = c.add(core.Term.Pi(true, bound, signed), span).unwrap()
    c.add(core.Term.Pi(false, word, proof_function), span).unwrap()
    c
}

fn load_callback_inference() {
    let context = [core.Binding { ty: 1, erased: false }, core.Binding { ty: 4, erased: true }]
    var limited = load_fixture()
    spend(&limited, 999934)
    assert(match limited.infer(13, context, true, 32) {
        Err(e) => e.msg == "core: checking step limit reached", _ => false
    }, "load exhausts the budget lowering its callback result")
    assert(limited.node_count() == 37 && limited.term(36) == core.Term.Buffer(35),
        "load compared the shifted owner type before lowering the result")

    var completed = load_fixture()
    spend(&completed, 999933)
    let result = completed.infer(13, context, true, 32).unwrap()
    assert(result == 2 && completed.term(24) == core.Term.Lt(0, 5) &&
        completed.term(35) == core.Term.Var(2) && completed.term(36) == core.Term.Buffer(35),
        "load checks the original evidence and lifts the open buffer length into the callback")
    assert_spent(&completed, "load inference uses 67 ticks")
}

fn reference_fixture() -> core.Core {
    var c = core.Core.new()
    let span = diag.Span.nowhere()
    let length = c.add(core.Term.Natural(2), span).unwrap()
    let fill = c.add(core.Term.Integer(-7), span).unwrap()
    let written = c.add(core.Term.Buffer(length), span).unwrap()
    c.add(core.Term.Ref(written), span).unwrap()
    let owner = c.add(core.Term.Alloc(length, fill), span).unwrap()
    let borrowed = c.add(core.Term.Borrow(owner), span).unwrap()
    c.add(core.Term.Deref(borrowed), span).unwrap()
    c.add(core.Term.Universe(0), span).unwrap()
    c
}

fn family_reference_fixture(recursive: bool) -> core.Core {
    var c = core.Core.new()
    let span = diag.Span.nowhere()
    c.add(core.Term.Natural(0), span).unwrap()
    let family = c.add(core.Term.Ind(0, Vec(u32).new()), span).unwrap()
    let word = c.add(core.Term.U64, span).unwrap()
    let successor = c.add(core.Term.Pi(false, if recursive { family } else { word }, family), span).unwrap()
    let local = c.add(core.Term.Var(0), span).unwrap()
    let borrowed = c.add(core.Term.Borrow(local), span).unwrap()
    c.add(core.Term.Deref(borrowed), span).unwrap()
    c.push_family(core.Family { name: "Chain".to_string(), data: true, params: 0, arity: 0,
        constructors: Vec(core.Constructor).new(), globals: 0, span })
    c.push_constructor(0, core.Constructor { name: "End".to_string(), ty: family })
    c.push_constructor(0, core.Constructor { name: "More".to_string(), ty: successor })
    c.check().unwrap()
    c
}

fn reference_inference() {
    var form = reference_fixture()
    spend(&form, 999991)
    assert(form.infer(3, [], true, 32).unwrap() == 11, "Ref checks its sort and owned head")
    assert_spent(&form, "Ref inference uses 9 ticks")

    var loan = reference_fixture()
    spend(&loan, 999988)
    assert(loan.infer(5, [], true, 32).unwrap() == 13 && loan.term(13) == core.Term.Ref(12),
        "Borrow retains the original inferred owner type")
    assert_spent(&loan, "Borrow inference uses 12 ticks")

    var read = reference_fixture()
    spend(&read, 999984)
    assert(read.infer(6, [], true, 32).unwrap() == 12 && read.term(12) == core.Term.Buffer(0),
        "Deref reuses the target of the inferred reference")
    assert_spent(&read, "Deref inference uses 16 ticks")

    var boxed = family_reference_fixture(true)
    let context = [core.Binding { ty: 1, erased: false }]
    assert(boxed.is_boxed(0), "checking records the recursive data family as boxed")
    spend(&boxed, 999992)
    assert(boxed.infer(6, context, true, 32).unwrap() == 1 && boxed.term(10) == core.Term.Ref(1),
        "Deref of a boxed family borrow retains the checked family type")
    assert_spent(&boxed, "boxed family dereference uses 7 ticks after checking the family")

    var flat = family_reference_fixture(false)
    assert(!flat.is_boxed(0), "checking records a nonrecursive scalar family as flat")
    spend(&flat, 999993)
    assert(match flat.infer(5, context, true, 32) {
        Err(e) => e.msg == "core: a borrow is of a buffer or heap data", _ => false
    }, "the owned-head gate rejects a flat family")
    assert(flat.node_count() == 10, "the rejected borrow appends no type")
}

fn family_index_fixture(data: bool, checked: bool) -> core.Core {
    var c = core.Core.new()
    let span = diag.Span.nowhere()
    let index = c.add(core.Term.Natural(0), span).unwrap()
    var indexes = Vec(u32).new()
    indexes.push(index)
    let result = c.add(core.Term.Ind(0, indexes), span).unwrap()
    c.add(core.Term.Ind(0, Vec(u32).new()), span).unwrap()
    c.push_family(core.Family { name: "AtZero".to_string(), data, params: 0, arity: 1,
        constructors: Vec(core.Constructor).new(), globals: 0, span })
    c.push_constructor(0, core.Constructor { name: "Intro".to_string(), ty: result })
    if checked { c.check().unwrap() }
    c
}

fn family_index_inference() {
    for data in [false, true] {
        var checked = family_index_fixture(data, true)
        spend(&checked, 999990)
        let formed = checked.infer(1, [], true, 1).unwrap()
        assert(formed == 7 && checked.term(7) == (if data { core.Term.Universe(0) } else { core.Term.Prop }),
            "the checked family selects its sort after checking the original index at fixed depth")
        assert_spent(&checked, "family formation uses five ticks beyond the declaration checks")
    }

    var invisible = family_index_fixture(false, false)
    assert(match invisible.infer(1, [], true, 1) {
        Err(e) => e.msg == "core: inductive family used before its declaration is checked", _ => false
    }, "family inference uses the visible checked declarations")

    var wrong = family_index_fixture(false, true)
    assert(match wrong.infer(2, [], true, 1) {
        Err(e) => e.msg == "core: wrong number of family indices", _ => false
    }, "arity is checked before forming the U64 requirement")
    assert(wrong.node_count() == 5, "an incorrect family arity appends no rows")
}

fn main() -> i32 {
    primitive_inference()
    erased_lambda()
    impredicative_product()
    decision_inference()
    zero_bound_inference()
    subtract_bound_exhaustion()
    conditional_inference()
    refinement_inference()
    pack_evidence_exhaustion()
    proof_irrelevance_under_type_family()
    refinement_projection()
    transport_evidence_exhaustion()
    offset_proof_inference()
    transitive_proof_inference()
    absurd_inference()
    wide_ghost_sum()
    array_and_allocation_inference()
    buffer_operation_inference()
    array_and_borrowed_index_inference()
    load_callback_inference()
    reference_inference()
    family_index_inference()
    println("Native Core.infer matched primitive, binder, evidence, conditional, refinement and transport graph traces and checking costs")
    0
}
