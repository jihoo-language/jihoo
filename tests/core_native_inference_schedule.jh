// Check the arena rows and exact work used by the primitive ghost inference
// fixtures in NativeCoreGhostSpineInference. The public atomic normalizer
// charges one tick per call, so the shared checker limit measures inference
// cost without exposing or modifying Core's private counter.
import core
import diag

fn fixture() -> core.Core {
    var c = core.Core.new()
    let span = diag.Span.nowhere()
    let seven = c.add(core.Term.Natural(7), span).unwrap()
    let one = c.add(core.Term.Natural(1), span).unwrap()
    let sum = c.add(core.Term.UAdd(seven, one), span).unwrap()
    c.add(core.Term.Eq(sum, sum), span).unwrap()
    c.add(core.Term.Refl(sum), span).unwrap()
    let signed = c.add(core.Term.Integer(1), span).unwrap()
    c.add(core.Term.Eq(signed, sum), span).unwrap()
    c
}

fn spend(inout c: core.Core, count: i64) {
    for _ in 0..count {
        assert(c.normal(0, core.DEPTH).unwrap() == 0, "atomic normalization")
    }
}

fn main() -> i32 {
    var good = fixture()
    spend(&good, 999987)
    let inferred = good.infer(4, [], true, 16).unwrap()
    assert(inferred == 12 && good.node_count() == 13, "result position")
    for i in 7..12 { assert(good.term(i as u32) == core.Term.U64, "expected word rows") }
    assert(good.term(inferred) == core.Term.Eq(2, 2), "original sum references")
    assert(match good.normal(0, core.DEPTH) {
        Err(e) => e.msg == "core: checking step limit reached", _ => false
    }, "successful inference used 13 ticks")

    var bad = fixture()
    spend(&bad, 999995)
    assert(match bad.infer(6, [], true, 16) {
        Err(e) => e.msg == "core: type mismatch", _ => false
    }, "signed operand rejected")
    assert(bad.node_count() == 9 && bad.term(7) == core.Term.U64 && bad.term(8) == core.Term.I64,
        "only first operand's rows remain")
    assert(match bad.normal(0, core.DEPTH) {
        Err(e) => e.msg == "core: checking step limit reached", _ => false
    }, "rejected inference used 5 ticks")
    println("Native Core.infer matched both graph outputs and checking costs")
    0
}
