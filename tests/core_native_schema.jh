// Exhaustive serializer fixture: no typing assumptions on these individual nodes.
import core
import core_native_snapshot

fn child(offset: i64) -> u32 {
    4294967295 - offset as u32
}

fn refs(start: i64, count: i64) -> Vec(u32) {
    var out = Vec(u32).new()
    for i in 0..count { out.push(child(start + i)) }
    out
}

fn emit(count: i64) {
    {
        var out = String.new()
        core_native_snapshot.write_node(&out, core.Term.Var(0))
        print(count)
        print("\tVar\t")
        println(out)
    }
    {
        var out = String.new()
        core_native_snapshot.write_node(&out, core.Term.Global(0))
        print(count)
        print("\tGlobal\t")
        println(out)
    }
    {
        var out = String.new()
        core_native_snapshot.write_node(&out, core.Term.Universe(0))
        print(count)
        print("\tUniverse\t")
        println(out)
    }
    {
        var out = String.new()
        core_native_snapshot.write_node(&out, core.Term.Prop)
        print(count)
        print("\tProp\t")
        println(out)
    }
    {
        var out = String.new()
        core_native_snapshot.write_node(&out, core.Term.U64)
        print(count)
        print("\tU64\t")
        println(out)
    }
    {
        var out = String.new()
        core_native_snapshot.write_node(&out, core.Term.I64)
        print(count)
        print("\tI64\t")
        println(out)
    }
    {
        var out = String.new()
        core_native_snapshot.write_node(&out, core.Term.Array(child(0)))
        print(count)
        print("\tArray\t")
        println(out)
    }
    {
        var out = String.new()
        core_native_snapshot.write_node(&out, core.Term.Lt(child(0), child(1)))
        print(count)
        print("\tLt\t")
        println(out)
    }
    {
        var out = String.new()
        core_native_snapshot.write_node(&out, core.Term.Eq(child(0), child(1)))
        print(count)
        print("\tEq\t")
        println(out)
    }
    {
        var out = String.new()
        core_native_snapshot.write_node(&out, core.Term.Refl(child(0)))
        print(count)
        print("\tRefl\t")
        println(out)
    }
    {
        var out = String.new()
        core_native_snapshot.write_node(&out, core.Term.Transport(child(0), child(1), child(2)))
        print(count)
        print("\tTransport\t")
        println(out)
    }
    {
        var out = String.new()
        core_native_snapshot.write_node(&out, core.Term.Ind(0, refs(0, count)))
        print(count)
        print("\tInd\t")
        println(out)
    }
    {
        var out = String.new()
        core_native_snapshot.write_node(&out, core.Term.Con(0, 0, refs(0, count)))
        print(count)
        print("\tCon\t")
        println(out)
    }
    {
        var out = String.new()
        core_native_snapshot.write_node(&out, core.Term.Elim(0, child(0), refs(1, count), child(count + 1)))
        print(count)
        print("\tElim\t")
        println(out)
    }
    {
        var out = String.new()
        core_native_snapshot.write_node(&out, core.Term.Arith(core.Arith.Add, child(0), child(1)))
        print(count)
        print("\tArith\t")
        println(out)
    }
    {
        var out = String.new()
        core_native_snapshot.write_node(&out, core.Term.Fold(child(0), child(1), child(2)))
        print(count)
        print("\tFold\t")
        println(out)
    }
    {
        var out = String.new()
        core_native_snapshot.write_node(&out, core.Term.Strict(child(0), child(1)))
        print(count)
        print("\tStrict\t")
        println(out)
    }
    {
        var out = String.new()
        core_native_snapshot.write_node(&out, core.Term.UAdd(child(0), child(1)))
        print(count)
        print("\tUAdd\t")
        println(out)
    }
    {
        var out = String.new()
        core_native_snapshot.write_node(&out, core.Term.LtAdd(child(0), child(1), child(2), child(3)))
        print(count)
        print("\tLtAdd\t")
        println(out)
    }
    {
        var out = String.new()
        core_native_snapshot.write_node(&out, core.Term.LtCancel(child(0), child(1), child(2), child(3)))
        print(count)
        print("\tLtCancel\t")
        println(out)
    }
    {
        var out = String.new()
