        println(out)
    }
    {
        var out = String.new()
        core_native_snapshot.write_node(&out, core.Term.Refine(child(0)))
        print(count)
        print("\tRefine\t")
        println(out)
    }
    {
        var out = String.new()
        core_native_snapshot.write_node(&out, core.Term.Pack(child(0), child(1), child(2)))
        print(count)
        print("\tPack\t")
        println(out)
    }
    {
        var out = String.new()
        core_native_snapshot.write_node(&out, core.Term.Witness(child(0)))
        print(count)
        print("\tWitness\t")
        println(out)
