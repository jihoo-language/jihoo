    {
        var out = String.new()
        core_native_snapshot.write_node(&out, core.Term.Proof(child(0)))
        print(count)
        print("\tProof\t")
        println(out)
    }
    {
        var out = String.new()
        core_native_snapshot.write_node(&out, core.Term.Buffer(child(0)))
        print(count)
        print("\tBuffer\t")
        println(out)
    }
    {
        var out = String.new()
        core_native_snapshot.write_node(&out, core.Term.Alloc(child(0), child(1)))
        print(count)
        print("\tAlloc\t")
        println(out)
    }
    {
        var out = String.new()
