    {
        var out = String.new()
        core_native_snapshot.write_node(&out, core.Term.Take(child(0), child(1)))
        print(count)
        print("\tTake\t")
        println(out)
    }
    {
        var out = String.new()
        core_native_snapshot.write_node(&out, core.Term.Borrow(child(0)))
        print(count)
        print("\tBorrow\t")
        println(out)
    }
    {
        var out = String.new()
        core_native_snapshot.write_node(&out, core.Term.Deref(child(0)))
        print(count)
        print("\tDeref\t")
        println(out)
    }
    {
        var out = String.new()
        core_native_snapshot.write_node(&out, core.Term.View(false, 0, child(0), refs(1, count), child(count + 1)))
        print(count)
        print("\tView\t")
        println(out)
    }
    {
        var out = String.new()
        core_native_snapshot.write_node(&out, core.Term.Loop(child(0), child(1), child(2), child(3)))
        print(count)
        print("\tLoop\t")
        println(out)
    }
    {
        var out = String.new()
        core_native_snapshot.write_node(&out, core.Term.Absurd(child(0), child(1)))
        print(count)
        print("\tAbsurd\t")
        println(out)
    }
    {
        var out = String.new()
        core_native_snapshot.write_node(&out, core.Term.Case(0, child(0), refs(1, count), child(count + 1)))
