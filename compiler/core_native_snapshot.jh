// Full native constructor snapshots for mechanized kernel correspondence.
// This exporter performs actual Core calls; source/IO fidelity remains trusted.
import core
import core_parse

fn token(inout out: String, value: u64) {
    var n = value
    while n > 0 {
        out.push(if n % 2 == 0 { '0' } else { '1' })
        n /= 2
    }
    out.push(';')
}

fn node(inout out: String, tag: u64, payload: [u64], refs: [u32]) {
    token(&out, tag)
    token(&out, payload.len as u64)
    for value in payload { token(&out, value) }
    token(&out, refs.len as u64)
    for reference in refs { token(&out, reference as u64) }
}

// Exhaustive on the production Term enum, including all ownership and family
// forms. Use the same ordered references as Core.extend's graph check.
pub fn write_node(inout out: String, term: core.Term) {
    let children = core.children(term)
    let refs = children.as_slice()
    match term {
        Var(x0) => node(&out, 0, [x0 as u64], refs)
        Global(x0) => node(&out, 1, [x0 as u64], refs)
        Universe(x0) => node(&out, 2, [x0 as u64], refs)
        Prop => node(&out, 3, [], refs)
        U64 => node(&out, 4, [], refs)
        I64 => node(&out, 5, [], refs)
        Array(_) => node(&out, 6, [], refs)
        Lt(_, _) => node(&out, 7, [], refs)
        Eq(_, _) => node(&out, 8, [], refs)
        Refl(_) => node(&out, 9, [], refs)
        Transport(_, _, _) => node(&out, 10, [], refs)
        Ind(x0, x1) => node(&out, 11, [x0 as u64, x1.len() as u64], refs)
        Con(x0, x1, x2) => node(&out, 12, [x0 as u64, x1 as u64, x2.len() as u64], refs)
        Elim(x0, _, x2, _) => node(&out, 13, [x0 as u64, x2.len() as u64], refs)
        Arith(x0, _, _) => {
            let op: u64 = match x0 { Add => 0, Sub => 1, Mul => 2 }
            node(&out, 14, [op], refs)
        }
        Fold(_, _, _) => node(&out, 15, [], refs)
        Strict(_, _) => node(&out, 16, [], refs)
        UAdd(_, _) => node(&out, 17, [], refs)
        LtAdd(_, _, _, _) => node(&out, 18, [], refs)
        LtCancel(_, _, _, _) => node(&out, 19, [], refs)
        LtLe(_, _, _, _, _) => node(&out, 20, [], refs)
        USub(_, _, _) => node(&out, 21, [], refs)
        ZeroLe(_) => node(&out, 22, [], refs)
        Refine(_) => node(&out, 23, [], refs)
        Pack(_, _, _) => node(&out, 24, [], refs)
        Witness(_) => node(&out, 25, [], refs)
        Proof(_) => node(&out, 26, [], refs)
        Buffer(_) => node(&out, 27, [], refs)
        Alloc(_, _) => node(&out, 28, [], refs)
        Load(_, _, _, _) => node(&out, 29, [], refs)
        Store(_, _, _, _) => node(&out, 30, [], refs)
        Free(_, _) => node(&out, 31, [], refs)
        Drop(x0, _, _) => node(&out, 32, [x0 as u64], refs)
        Ref(_) => node(&out, 33, [], refs)
        Lend(_, _, _) => node(&out, 34, [], refs)
        Back(x0, _, _) => node(&out, 35, [if x0 { 1 } else { 0 }], refs)
        Give(x0, _, _, _) => node(&out, 36, [if x0 { 1 } else { 0 }], refs)
        Take(_, _) => node(&out, 37, [], refs)
        Borrow(_) => node(&out, 38, [], refs)
        Deref(_) => node(&out, 39, [], refs)
        View(x0, x1, _, x3, _) => node(
            &out,
            40,
            [if x0 { 1 } else { 0 }, x1 as u64, x3.len() as u64],
            refs
        )
        Loop(_, _, _, _) => node(&out, 41, [], refs)
        Absurd(_, _) => node(&out, 42, [], refs)
        Case(x0, _, x2, _) => node(&out, 43, [x0 as u64, x2.len() as u64], refs)
        Pi(x0, _, _) => node(&out, 44, [if x0 { 1 } else { 0 }], refs)
        Lam(x0, _, _) => node(&out, 45, [if x0 { 1 } else { 0 }], refs)
        App(_, _) => node(&out, 46, [], refs)
        Natural(x0) => node(&out, 47, [x0 as u64], refs)
        Integer(x0) => node(
            &out,
            48,
            [if x0 < 0 { 1 } else { 0 }, if x0 < 0 { (0 -% x0) as u64 } else { x0 as u64 }],
            refs
        )
        Elements(x0) => node(&out, 49, [x0.len() as u64], refs)
        Index(_, _, _) => node(&out, 50, [], refs)
        Decide(_, _) => node(&out, 51, [], refs)
        IfLt(_, _, _, _) => node(&out, 52, [], refs)
        IfEq(_, _, _, _) => node(&out, 53, [], refs)
    }
}

// Retain an exact arena without running any additional Core operation.
pub fn arena(c: core.Core, ghost: bool, term_root: u32, type_root: u32) -> String {
    var out = String.new()
    for field in [4 as u64, if ghost { 1 } else { 0 }, term_root as u64,
        type_root as u64, c.node_count() as u64] { token(&out, field) }
    for node_index in 0..c.node_count() { write_node(&out, c.term(node_index as u32)) }
    out
}

// Version 5 retains every ordered declaration and the entire shared arena.
// The input supplies no declaration modes or inferred typing certificates.
pub fn program_arena(c: core.Core) -> String {
    var out = String.new()
    token(&out, 5)
    token(&out, c.definition_count() as u64)
    for definition_index in 0..c.definition_count() {
        let definition = c.definition(definition_index)
        token(&out, definition.ty as u64)
        token(&out, definition.value as u64)
    }
    token(&out, c.node_count() as u64)
    for node_index in 0..c.node_count() { write_node(&out, c.term(node_index as u32)) }
    out
}

pub fn program_snapshot(source: str) -> Result(String, String) {
    var c = match core_parse.parse(source, 0) {
        Ok(c) => c
        Err(e) => return Err(e.msg.clone())
    }
    if c.family_count() != 0 {
        return Err("program snapshot does not yet support families".to_string())
    }
    match c.check() { Ok(_) => {}, Err(e) => return Err(e.msg.clone()) }
    Ok(program_arena(c))
}

// Version 6 retains the raw family declarations in addition to definitions.
// Positivity/signatures/layout are recomputed by the receiving checker.
pub fn family_program_arena(c: core.Core) -> String {
    var out = String.new()
    token(&out, 6)
    token(&out, c.definition_count() as u64)
    for definition_index in 0..c.definition_count() {
        let definition = c.definition(definition_index)
        token(&out, definition.ty as u64)
        token(&out, definition.value as u64)
    }
    token(&out, c.family_count() as u64)
    for family_index in 0..c.family_count() {
        let family = c.family(family_index)
        token(&out, if family.data { 1 } else { 0 })
        token(&out, family.params as u64)
        token(&out, family.arity as u64)
        token(&out, family.globals as u64)
        token(&out, family.constructors.len() as u64)
        for constructor in family.constructors { token(&out, constructor.ty as u64) }
    }
    token(&out, c.node_count() as u64)
    for node_index in 0..c.node_count() { write_node(&out, c.term(node_index as u32)) }
    out
}

pub fn family_program_snapshot(source: str) -> Result(String, String) {
    var c = match core_parse.parse(source, 0) {
        Ok(c) => c
        Err(e) => return Err(e.msg.clone())
    }
    match c.check() { Ok(_) => {}, Err(e) => return Err(e.msg.clone()) }
    Ok(family_program_arena(c))
}

pub fn snapshot(source: str, mode: str) -> Result(String, String) {
    let ghost = mode == "infer" || mode == "require"
    if !ghost && mode != "code-infer" && mode != "code-require" {
        return Err("expected infer, require, code-infer or code-require".to_string())
    }
    var c = match core_parse.parse(source, 0) {
        Ok(c) => c
        Err(e) => return Err(e.msg.clone())
    }
    if c.definition_count() != 1 || c.family_count() != 0 {
        return Err("expected exactly one definition and no families".to_string())
    }
    let value = c.definition(0).value
    let declared = c.definition(0).ty
    match c.check() { Ok(_) => {}, Err(e) => return Err(e.msg.clone()) }
    let inferred = match c.infer(value, [], ghost, core.DEPTH) {
        Ok(ty) => ty
        Err(e) => return Err(e.msg.clone())
    }
    let selected = if mode == "require" || mode == "code-require" {
        match c.require(value, declared, [], ghost, core.DEPTH) {
            Ok(_) => {}
            Err(e) => return Err(e.msg.clone())
        }
        declared
    } else { inferred }
    Ok(arena(c, ghost, value, selected))
}
